            "500": "#ef4444",
            "600": "#dc2626",
            "700": "#b91c1c",
            "800": "#991b1b",
            "900": "#7f1d1d",
            "950": "#450a0a"
        },
        "warning": {
            "50": "#fffbeb",
            "100": "#fef3c7",
            "200": "#fde68a",
            "300": "#fcd34d",
            "400": "#fbbf24",
            "500": "#f59e0b",
            "600": "#d97706",
            "700": "#b45309",
            "800": "#92400e",
            "900": "#78350f",
            "950": "#451a03"
        },
        "success": {
            "50": "#f0fdf4",
            "100": "#dcfce7",
            "200": "#bbf7d0",
            "300": "#86efac",
            "400": "#4ade80",
            "500": "#22c55e",
            "600": "#16a34a",
            "700": "#15803d",
            "800": "#166534",
            "900": "#14532d",
            "950": "#052e16"
        }
    },
    "fonts": {
        "primary": "Inter",
        "display": "Poppins",
        "mono": "JetBrains Mono"
    },
    "layout": {
        "sidebar": {
            "width": "256px",
            "collapsedWidth": "64px",
            "backgroundColor": "#ffffff",
            "borderColor": "#e5e7eb"
        },
        "header": {
            "height": "64px",
            "backgroundColor": "#ffffff",
            "borderColor": "#e5e7eb"
        },
        "content": {
            "maxWidth": "1200px",
            "padding": "24px"
        }
    },
    "features": {
        "authentication": true,
        "contentManagement": true,
        "userProfile": true,
        "notifications": false,
        "darkMode": false,
        "multiLanguage": false,
        "analytics": false,
        "realTimeUpdates": false
    },
    "api": {
        "baseURL": "https://api.yourcompany.com",
        "timeout": 10000,
        "retryAttempts": 3,
        "retryDelay": 1000
    },
    "pagination": {
        "defaultPageSize": 10,
        "pageSizeOptions": [
            10,
            25,
            50,
            100
        ],
        "showSizeChanger": true,
        "showQuickJumper": true
    },
    "upload": {
        "maxFileSize": "10MB",
        "allowedTypes": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp"
        ],
        "maxFiles": 5,
        "uploadPath": "/uploads"
    },
    "validation": {
        "email": {
            "required": true,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "password": {
            "minLength": 6,
            "requireUppercase": false,
            "requireLowercase": false,
            "requireNumbers": false,
            "requireSpecialChars": false
        },
        "phone": {
            "pattern": "^\\+?[1-9]\\d{1,14}$"
        }
    },
    "social": {
        "facebook": "https://facebook.com/yourcompany",
        "twitter": "https://twitter.com/yourcompany",
        "linkedin": "https://linkedin.com/company/yourcompany",
        "instagram": "https://instagram.com/yourcompany",
        "youtube": "https://youtube.com/yourcompany"
    },
    "contact": {
        "address": "123 Business Street, City, State 12345",
        "phone": "+1 (555) 123-4567",
        "email": "info@yourcompany.com",
        "hours": "Monday - Friday: 9:00 AM - 6:00 PM"
    }
}